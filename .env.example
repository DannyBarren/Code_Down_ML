# Code_Down_ML — environment variables
#
# The app reads the process environment. It does not load this file
# automatically (no python-dotenv). Copy the values you need:
#
#   export FILLDOWN_DEMO=0
#   streamlit run main.py
#
# Docker / Hugging Face Spaces set these in the image or the Space settings.
# Never commit a real .env — it is gitignored.

# Writable root for SQLite, trained models, work files, logs, and caches.
# Default: ./data  (falls back to a temp dir if that path is not writable)
# FILLDOWN_DATA_DIR=./data

# Hugging Face persistent storage (same role as FILLDOWN_DATA_DIR).
# HF_DATA_DIR=/data

# Override the SQLite path. Tests use a throwaway file so the shipped
# sample ledger is never touched.
# FILLDOWN_DB_PATH=/tmp/code_down.db

# Public demo: banner, sample auto-load, optional wipe of the knowledge
# base on start. Local / production installs should leave this at 0.
FILLDOWN_DEMO=0

# Only consulted when FILLDOWN_DEMO=1 (or when running on a Hugging Face
# Space). 1 wipes DB/models on startup; 0 keeps demo data across restarts.
FILLDOWN_DEMO_RESET=1

# Soft per-upload row cap. 0 = unlimited.
FILLDOWN_MAX_ROWS=0

# Presence of either variable implies demo mode (Hugging Face Spaces).
# SPACE_ID=
# HF_SPACE_ID=

# Hugging Face cache (set by the Dockerfile to keep weights on the volume).
# HF_HOME=/data/.huggingface
